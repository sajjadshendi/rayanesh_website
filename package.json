{
  "name": "rayanesh-magazine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "node scripts/validate-content.mjs && astro check",
    "build": "npm run check && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm test && npm run build",
    "new": "node scripts/new-content.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@fontsource-variable/noto-naskh-arabic": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "astro": "7.3.7",
    "katex": "0.19.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "gray-matter": "4.0.3",
    "linkedom": "0.18.13",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.5"
  }
}
