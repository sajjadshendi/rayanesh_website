---
import { type Author, avatarTone } from '../lib/catalog';
interface Props { author: Author; size?: 'sm' | 'md' | 'lg' }
const { author, size = 'sm' } = Astro.props;
const px = { sm: 32, md: 52, lg: 64 }[size];
---
{author.data.avatar
  ? <img class:list={['avatar', `avatar-${size}`]} src={author.data.avatar} alt="" width={px} height={px} loading="lazy" decoding="async" />
  : <span class:list={['avatar', `avatar-${size}`]} data-tone={avatarTone(author.data.name)} aria-hidden="true">{author.data.name.trim().slice(0, 1)}</span>}
