---
import { topics } from '../lib/catalog';
interface Props { current?: string }
const { current } = Astro.props;
---
<nav class="topic-nav" aria-label="مرور موضوع‌ها">
  <div class="topic-nav-track">
    <a class="topic-chip" href="/articles/" aria-current={current ? undefined : 'page'}>همهٔ نوشته‌ها</a>
    {Object.entries(topics).map(([id, label]) => (
      <a class="topic-chip" href={`/topics/${id}/`} aria-current={id === current ? 'page' : undefined}>{label}</a>
    ))}
  </div>
</nav>
