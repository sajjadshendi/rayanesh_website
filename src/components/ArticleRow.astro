---
import { withBase } from '../lib/paths';
import Avatar from './Avatar.astro';
import { type Article, type Author, type Issue, issueLabel } from '../lib/catalog';
interface Props { article: Article; authorMap: Map<string, Author>; issueMap?: Map<string, Issue>; prominent?: boolean; level?: 2 | 3 }
const { article, authorMap, issueMap, prominent = false, level = 2 } = Astro.props;
const Heading = level === 3 ? 'h3' : 'h2';
const writers = article.data.authors.map(id => authorMap.get(id)!);
const first = writers[0];
const href = `/articles/${article.id}/`;
const issue = issueMap?.get(article.data.issue);
const thumb = article.data.image || issue?.data.cover;
---
<article class:list={['article-row', { prominent, 'has-media': Boolean(thumb) }]}>
  {thumb && <a data-astro-prefetch class="article-row-media" href={withBase(href)} tabindex="-1" aria-hidden="true"><img src={withBase(thumb)} alt="" width="240" height="180" loading="lazy" decoding="async" /></a>}
  <div class="article-row-body">
    {issue && <p class="eyebrow">{issueLabel(issue)}{article.data.edition === 'excerpt' ? ' · گزیده' : ''}</p>}
    <Heading class="article-title"><a data-astro-prefetch href={withBase(href)}>{article.data.title}</a></Heading>
    <p class="article-description">{article.data.description}</p>
    <p class="byline">
      <span class="author-chip">
        <Avatar author={first} />
        <span>{writers.map((writer, i) => <><a data-astro-prefetch href={withBase(`/authors/${article.data.authors[i]}/`)}>{writer.data.name}</a>{i < writers.length - 1 && '، '}</>)}</span>
      </span>
    </p>
  </div>
</article>
