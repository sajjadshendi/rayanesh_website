---
import { type Issue, issueLabel } from '../lib/catalog';
interface Props { issue: Issue; level?: 2 | 3 }
const { issue, level = 2 } = Astro.props;
const Heading = level === 3 ? 'h3' : 'h2';
const href = `/issues/${issue.id}/`;
---
<article class="issue-card">
  <div class="cover-frame">
    <a class="cover-link" href={href} tabindex="-1" aria-hidden="true"><img src={issue.data.cover} alt="" width="750" height="1060" loading="lazy" decoding="async" /></a>
    <div class="cover-actions">
      <a class="cover-action-primary" href={href} aria-label={`مشاهدهٔ ${issue.data.title}`}>مشاهده</a>
      <a class="cover-action-ghost" href={issue.data.pdf} aria-label={`نسخهٔ PDF ${issue.data.title}`}>PDF <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="issue-card-meta">
    <p class="issue-tags">
      <span class="pill">{issueLabel(issue)}</span>
      <span class="issue-date">{issue.data.dateLabel || '—'}</span>
    </p>
    <Heading class="issue-title"><a href={href}>{issue.data.title}</a></Heading>
    <p class="issue-card-actions">
      <a class="button issue-action" href={href}>مشاهده</a>
      <a class="button button-ghost issue-action" href={issue.data.pdf}>PDF <span aria-hidden="true">↗</span></a>
    </p>
  </div>
</article>
