---
import { withBase } from '../../lib/paths';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCatalog, issueLabel, issueByline, fa } from '../../lib/catalog';
export async function getStaticPaths() { const { issues } = await getCatalog(); return issues.map(issue => ({ params: { id: issue.id }, props: { issue } })); }
const { issue } = Astro.props;
const { issues } = await getCatalog();
const latestRegular = issues.find(item => item.data.kind === 'regular');
const latestSpecial = issues.find(item => item.data.kind === 'special');
const linkArticles = issue.id === latestRegular?.id || issue.id === latestSpecial?.id;
const tocHeading = issue.data.kind === 'regular' ? 'در این شماره' : 'در این ویژه‌نامه';
//const showEyebrow = issue.data.kind === 'regular' || (Boolean(issue.data.dateLabel) && !/ویژه[\u200c\s]*نامه/.test(issue.data.title));
const showEyebrow = true;
---
<Base title={`${issueLabel(issue)}؛ ${issue.data.title}`} description={issue.data.description} image={issue.data.cover} imageAlt={issue.data.coverAlt} entity={{ '@type': 'PublicationIssue', name: issue.data.title, description: issue.data.description, ...(issue.data.number ? { issueNumber: issue.data.number } : {}), isPartOf: { '@type': 'Periodical', name: 'نشریه رایانش' }, inLanguage: 'fa-IR' }}>
  <div class="shell page">
    <Breadcrumb items={[{ href: '/issues/', label: 'گنجه' }, { label: issue.data.title }]} />
    <div class="issue-detail">
      <figure class="issue-cover"><img src={withBase(issue.data.cover)} alt={issue.data.coverAlt} width="750" height="1060" fetchpriority="high" /></figure>
      <div class="issue-detail-copy">
        {showEyebrow && <p class="eyebrow">{issueByline(issue, ' · ')}</p>}
        <h1>{issue.data.title}</h1>
        <p class="deck">{issue.data.description}</p>
        <a class="button" href={withBase(issue.data.pdf)}>خواندن نسخه PDF <span aria-hidden="true">↗</span></a>
        {issue.data.credits.length > 0 && (
          <details class="credits">
            <summary>
              <span>شناسنامه این شماره</span>
              <svg class="icon credits-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <dl>{issue.data.credits.map(credit => <div><dt>{credit.role}</dt><dd>{credit.names.join('، ')}</dd></div>)}</dl>
          </details>
        )}
      </div>
    </div>
    {issue.data.toc.length > 0 && (
      <section class="issue-toc">
        <div class="section-heading"><h2>{tocHeading}</h2></div>
        <ol class="contents-list">{issue.data.toc.map((entry, index) => (
          <li>
            <span class="index-number" aria-hidden="true">{fa(index + 1)}</span>
            <div>
              {linkArticles && entry.article
                ? <h3><a data-astro-prefetch href={withBase(`/articles/${entry.article}/`)}>{entry.title}</a></h3>
                : <h3>{entry.title}</h3>}
            </div>
          </li>
        ))}</ol>
      </section>
    )}
  </div>
</Base>
