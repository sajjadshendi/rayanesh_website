---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { getCatalog, topics, issueLabel, readingTime } from '../../lib/catalog';
export async function getStaticPaths() { const { articles } = await getCatalog(); return articles.map(article => ({ params: { id: article.id }, props: { article } })); }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const { issueMap, authorMap, articles } = await getCatalog();
const issue = issueMap.get(article.data.issue)!;
const sections = headings.filter(h => h.depth === 2 || h.depth === 3);
const related = articles.filter(a => a.id !== article.id && (a.data.issue === article.data.issue || a.data.topics.some(t => article.data.topics.includes(t)))).slice(0, 2);
---
<Base title={article.data.title} description={article.data.description} image={article.data.image || issue.data.cover} article>
  <div class="shell page article-page"><Breadcrumb items={[{ href: '/articles/', label: 'نوشته‌ها' }, { label: article.data.title }]} />
    <article itemscope itemtype="https://schema.org/Article">
      <header class="reading-header"><p class="eyebrow">{article.data.topics.map((id, i) => <><a href={`/topics/${id}/`}>{topics[id as keyof typeof topics]}</a>{i < article.data.topics.length - 1 && ' / '}</>)}</p><h1 itemprop="headline">{article.data.title}</h1><p class="deck" itemprop="description">{article.data.description}</p><div class="reading-meta"><p>{article.data.authors.map((id, i) => <><a href={`/authors/${id}/`} itemprop="author">{authorMap.get(id)!.data.name}</a>{i < article.data.authors.length - 1 && '، '}</>)}</p><a href={`/issues/${issue.id}/`}>{issueLabel(issue)} · {issue.data.title}</a><span>{readingTime(article.body)} دقیقه خواندن</span>{article.data.publishedAt && <time datetime={article.data.publishedAt} itemprop="datePublished">{new Date(article.data.publishedAt).toLocaleDateString('fa-IR', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })}</time>}</div></header>
      {article.data.image && <figure class="article-image"><img src={article.data.image} alt={article.data.imageAlt} width="798" height="665" decoding="async" />{article.data.imageCredit && <figcaption>{article.data.imageCredit}</figcaption>}</figure>}
      <div class="reading-layout"><aside class="reading-aside" aria-label="ابزارهای خواندن"><div class="reader-controls" id="reader-controls" hidden><span>اندازهٔ متن</span><button type="button" id="font-decrease" aria-label="کوچک‌تر کردن متن">−</button><button type="button" id="font-increase" aria-label="بزرگ‌تر کردن متن">+</button><span id="font-status" class="sr-only" aria-live="polite"></span></div>{sections.length > 0 && <details class="reading-toc" open><summary>در این نوشته</summary><nav aria-label="فهرست این نوشته"><ol>{sections.map(h => <li class:list={{ subheading: h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details>}<a class="source-link" href={`${issue.data.pdf}#page=${article.data.pdfPage}`}>این نوشته در نسخهٔ PDF ↗</a><button type="button" id="share-article" class="quiet-button" hidden>هم‌رسانی نوشته</button><span id="share-status" role="status" class="small"></span></aside>
      <div class="reading-body">{article.data.edition === 'excerpt' && <p class="editorial-note">این صفحه گزیده‌ای از مطلب است. <a href={`${issue.data.pdf}#page=${article.data.pdfPage}`}>متن کامل را در PDF شماره بخوانید.</a></p>}{article.data.audio && <figure class="audio-reading"><figcaption>خوانش: {article.data.audio.reader}</figcaption><audio controls preload="none" src={article.data.audio.src}>مرورگر شما پخش صوت را پشتیبانی نمی‌کند. <a href={article.data.audio.src}>دریافت فایل صوتی</a></audio><p class="small">متن خوانش در ادامهٔ همین صفحه آمده است.</p></figure>}<div class:list={['prose', { poem: article.data.format === 'poem' }]} itemprop="articleBody"><Content /></div><p class="source-note">از {issueLabel(issue)} رایانش. متن برای نمایش در وب با اصلاح فاصله‌گذاری حروف‌چینی شده است. <a href={`${issue.data.pdf}#page=${article.data.pdfPage}`}>نسخهٔ چاپی</a></p></div></div>
    </article>
    {related.length > 0 && <section class="related"><div class="section-heading"><h2>بعد از این نوشته</h2><a class="text-link" href="/articles/">بیشتر بخوانید ←</a></div><div class="related-grid">{related.map(a => <ArticleRow article={a} authorMap={authorMap} />)}</div></section>}
  </div>
  <script src="../../scripts/reader.ts"></script>
</Base>
