---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Arrow from '../../components/Arrow.astro';
import { getCatalog, issueLabel } from '../../lib/catalog';
export async function getStaticPaths() { const { articles } = await getCatalog(); return articles.map(article => ({ params: { id: article.id }, props: { article } })); }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const { issueMap, authorMap, articles } = await getCatalog();
const issue = issueMap.get(article.data.issue)!;
const sections = headings.filter(h => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
const siblings = articles.filter(item => item.data.issue === article.data.issue);
const index = siblings.findIndex(item => item.id === article.id);
const previous = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 ? siblings[index + 1] : undefined;
---
<Base title={article.data.title} description={article.data.description} image={article.data.image || issue.data.cover} article>
  <div class="shell page article-page">
    <Breadcrumb items={[{ href: '/articles/', label: 'نوشته‌ها' }, { label: article.data.title }]} />
    <article itemscope itemtype="https://schema.org/Article">
      <header class="reading-header">
        <h1 itemprop="headline">{article.data.title}</h1>
        <p class="deck" itemprop="description">{article.data.description}</p>
        <div class="reading-meta">
          <p>{article.data.authors.map((id, i) => <><a href={`/authors/${id}/`} itemprop="author">{authorMap.get(id)!.data.name}</a>{i < article.data.authors.length - 1 && '، '}</>)}</p>
          <a href={`/issues/${issue.id}/`}>{issue.data.kind === 'regular' ? `${issueLabel(issue)} · ${issue.data.title}` : issueLabel(issue)}</a>
          {article.data.publishedAt && <time datetime={article.data.publishedAt} itemprop="datePublished">{new Date(article.data.publishedAt).toLocaleDateString('fa-IR', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' })}</time>}
        </div>
      </header>
      {article.data.image && <figure class="article-image"><img src={article.data.image} alt={article.data.imageAlt} width="798" height="665" decoding="async" />{article.data.imageCredit && <figcaption>{article.data.imageCredit}</figcaption>}</figure>}
      <div class="reading-layout">
        <aside class="reading-aside" aria-label="ابزارهای خواندن">
          <div class="reader-controls" id="reader-controls" hidden>
            <span>اندازه متن</span>
            <button type="button" id="font-decrease" aria-label="کوچک‌تر کردن متن">−</button>
            <button type="button" id="font-increase" aria-label="بزرگ‌تر کردن متن">+</button>
            <span id="font-status" class="sr-only" aria-live="polite"></span>
          </div>
          {sections.length > 1 && (
            <details class="reading-toc" open>
              <summary>در این نوشته</summary>
              <nav aria-label="فهرست این نوشته">
                <ol>{sections.map(h => <li class:list={{ subheading: h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
              </nav>
            </details>
          )}
          <a class="source-link" href={`${issue.data.pdf}#page=${article.data.pdfPage}`}>این نوشته در نسخه PDF ↗</a>
          <button type="button" id="share-article" class="button button-ghost share-article" hidden>هم‌رسانی نوشته</button>
          <span id="share-status" role="status" class="small"></span>
        </aside>
        <div class="reading-body">
          {article.data.edition === 'excerpt' && <p class="editorial-note">این صفحه گزیده‌ای از مطلب است. <a href={`${issue.data.pdf}#page=${article.data.pdfPage}`}>متن کامل را در PDF شماره بخوانید.</a></p>}
          {article.data.audio && (
            <figure class="audio-reading">
              <figcaption>خوانش: {article.data.audio.reader}</figcaption>
              <audio controls preload="none" src={article.data.audio.src}>مرورگر شما پخش صوت را پشتیبانی نمی‌کند. <a href={article.data.audio.src}>دریافت فایل صوتی</a></audio>
              <p class="small">متن خوانش در ادامه همین صفحه آمده است.</p>
            </figure>
          )}
          <div class:list={['prose', { poem: article.data.format === 'poem' }]} itemprop="articleBody"><Content /></div>
          {(previous || next) && (
            <nav class="article-neighbors" aria-label="نوشته قبلی و بعدی">
              {previous && (
                <a class="article-neighbor article-neighbor-prev" href={`/articles/${previous.id}/`}>
                  <span class="article-neighbor-label">قبلی <Arrow class="icon-arrow-prev" /></span>
                  <strong>{previous.data.title}</strong>
                </a>
              )}
              {next && (
                <a class="article-neighbor article-neighbor-next" href={`/articles/${next.id}/`}>
                  <span class="article-neighbor-label">بعدی <Arrow /></span>
                  <strong>{next.data.title}</strong>
                </a>
              )}
            </nav>
          )}
        </div>
      </div>
    </article>
  </div>
  <script src="../../scripts/reader.ts"></script>
</Base>
