---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { getCatalog } from '../../lib/catalog';
const { authors, articles } = await getCatalog();
const countFor = (id: string) => articles.filter(a => a.data.authors.includes(id)).length;
const writers = authors.filter(a => countFor(a.id) > 0);
---
<Base title="نویسندگان" description="نویسندگان رایانش و نوشته‌هایشان در آرشیو وب.">
  <div class="shell page">
    <Breadcrumb items={[{ label: 'نویسندگان' }]} />
    <header class="page-heading">
      <h1>به قلمِ</h1>
    </header>
    <div class="author-grid author-grid-wide">{writers.map(author => <AuthorCard author={author} count={countFor(author.id)} level={2} bio />)}</div>
  </div>
</Base>
