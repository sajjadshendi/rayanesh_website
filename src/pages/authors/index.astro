---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCatalog, fa } from '../../lib/catalog';
const { authors, articles } = await getCatalog();
---
<Base title="نویسندگان" description="نویسندگان رایانش و نوشته‌هایشان در آرشیو وب."><div class="shell page"><Breadcrumb items={[{ label: 'نویسندگان' }]} /><header class="page-heading"><p class="eyebrow">آدم‌های پشت کلمه‌ها</p><h1>به قلمِ</h1><p>همراهانی که نوشته‌هایشان در این آرشیو منتشر شده است.</p></header><div class="author-list">{authors.filter(a => articles.some(p => p.data.authors.includes(a.id))).map(author => <article><div class="author-initial" aria-hidden="true">{author.data.name.slice(0,1)}</div><div><h2><a href={`/authors/${author.id}/`}>{author.data.name}</a></h2><p>{author.data.bio}</p></div><a class="text-link" href={`/authors/${author.id}/`}>{fa(articles.filter(a => a.data.authors.includes(author.id)).length)} نوشته <span aria-hidden="true">←</span></a></article>)}</div></div></Base>
