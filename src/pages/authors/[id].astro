---
import { withBase } from '../../lib/paths';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import Avatar from '../../components/Avatar.astro';
import { getCatalog, fa } from '../../lib/catalog';
export async function getStaticPaths() { const { authors, articles } = await getCatalog(); return authors.filter(a => articles.some(p => p.data.authors.includes(a.id))).map(author => ({ params: { id: author.id }, props: { author } })); }
const { author } = Astro.props;
const { articles, authorMap, issueMap, issues } = await getCatalog();
const selected = articles.filter(a => a.data.authors.includes(author.id));
const roles = [...new Set(issues.flatMap(issue => issue.data.credits.filter(credit => credit.names.includes(author.data.name)).map(credit => credit.role)))].filter(role => /سردبیر/.test(role));
---
<Base title={author.data.name} description={`معرفی ${author.data.name} و نوشته‌های او در نشریه رایانش. ${author.data.bio || ""}`} entity={{ "@type": author.id === "rayanesh-editorial-team" ? "Organization" : "Person", name: author.data.name, description: author.data.bio, url: Astro.site ? new URL(withBase(`/authors/${author.id}/`), Astro.site).href : undefined, ...(author.data.avatar && Astro.site ? { image: new URL(withBase(author.data.avatar), Astro.site).href } : {}) }}>
  <div class="shell page">
    <Breadcrumb items={[{ href: '/authors/', label: 'نویسندگان' }, { label: author.data.name }]} />
    <header class="page-heading author-heading">
      <Avatar author={author} size="md" labelled />
      <p class="eyebrow">به قلمِ</p>
      <h1>{author.data.name}</h1>
      {(roles.length > 0 || selected.length > 0) && (
        <p class="author-tags">
          {roles.map(role => <span class="pill pill-accent">{role}</span>)}
          <span class="pill">{fa(selected.length)} نوشته</span>
        </p>
      )}
      <p>{author.data.bio}</p>
      {author.data.links.length > 0 && <ul class="author-links">{author.data.links.map(link => <li><a href={withBase(link.url)} rel="me noopener noreferrer">{link.label}</a></li>)}</ul>}
    </header>
    <section class="author-works" aria-labelledby="author-works-heading">
      <h2 class="section-title" id="author-works-heading">نوشته‌ها در رایانش</h2>
      <div class="article-list">{selected.map(article => <ArticleRow article={article} authorMap={authorMap} issueMap={issueMap} />)}</div>
    </section>
  </div>
</Base>
