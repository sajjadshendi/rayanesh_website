---
import Base from '../../layouts/Base.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCatalog, topics } from '../../lib/catalog';
export function getStaticPaths() { return Object.entries(topics).map(([id, title]) => ({ params: { id }, props: { title } })); }
const { title } = Astro.props;
const { articles, authorMap } = await getCatalog();
const selected = articles.filter(a => a.data.topics.includes(Astro.params.id as keyof typeof topics));
---
<Base title={title} description={`نوشته‌های رایانش در ${title}`}><div class="shell page"><Breadcrumb items={[{ href: '/articles/', label: 'نوشته‌ها' }, { label: title }]} /><header class="page-heading"><p class="eyebrow">موضوع‌ها</p><h1>{title}</h1></header><nav class="topic-nav" aria-label="مرور موضوع‌ها"><a href="/articles/">همهٔ نوشته‌ها</a>{Object.entries(topics).map(([id, label]) => <a href={`/topics/${id}/`} aria-current={id === Astro.params.id ? 'page' : undefined}>{label}</a>)}</nav><div class="article-list">{selected.length ? selected.map(article => <ArticleRow article={article} authorMap={authorMap} />) : <p class="empty-state">نوشته‌های این بخش به‌زودی به آرشیو وب اضافه می‌شوند. فعلاً می‌توانید <a href="/issues/">شماره‌های مجله</a> را ورق بزنید.</p>}</div></div></Base>
