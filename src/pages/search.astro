---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getCatalog, issueByline } from '../lib/catalog';
const { issues } = await getCatalog();
const suggestions = [
  { href: '/articles/', label: 'نوشته‌ها' },
  { href: '/issues/', label: 'شماره‌ها' },
  { href: '/authors/', label: 'نویسندگان' },
];
---
<Base title="جست‌وجو" description="جست‌وجو در نوشته‌ها، نویسندگان و شماره‌های رایانش." noindex>
  <div class="shell page search-page">
    <Breadcrumb items={[{ label: 'جست‌وجو' }]} />
    <header class="page-heading">
      <p class="eyebrow">دنبال چه می‌گردید؟</p>
      <h1>میان سطرها</h1>
      <p>در متن نوشته‌ها، نام نویسنده‌ها و شماره‌ها جست‌وجو کنید.</p>
    </header>
    <form id="search-form" action="/search/" method="get" role="search">
      <label for="search-input">واژه یا نام مورد نظر</label>
      <div class="search-field">
        <input id="search-input" name="q" type="search" placeholder="مثلاً: خانه، شبکه، رایا…" maxlength="160" autocomplete="off" spellcheck="false" enterkeyhint="search" />
        <button class="button" type="submit">جست‌وجو</button>
      </div>
      <fieldset class="search-filters">
        <legend class="sr-only">محدود کردن نتایج</legend>
        <div class="search-filter-row" role="group" aria-label="نوع نتیجه">
          <label class="filter-chip"><input class="sr-only" type="radio" name="type" value="" checked /> همه</label>
          <label class="filter-chip"><input class="sr-only" type="radio" name="type" value="نوشته" /> نوشته‌ها</label>
          <label class="filter-chip"><input class="sr-only" type="radio" name="type" value="شماره" /> شماره‌ها</label>
          <label class="filter-chip"><input class="sr-only" type="radio" name="type" value="نویسنده" /> نویسندگان</label>
        </div>
        <label class="search-issue-label" for="search-issue">شماره مجله</label>
        <select id="search-issue" name="issue">
          <option value="">همه شماره‌ها</option>
          {issues.map(issue => <option value={issue.id}>{issueByline(issue, ' · ')}</option>)}
        </select>
      </fieldset>
    </form>
    <nav class="search-suggest" aria-label="شروع جست‌وجو">
      <p>برای شروع، یکی از بخش‌های سایت را باز کنید یا عبارتی بنویسید.</p>
      <div class="search-suggest-list">
        {suggestions.map(item => <a class="topic-chip" href={item.href}>{item.label}</a>)}
      </div>
    </nav>
    <p id="search-status" role="status" aria-live="polite" class="muted">عبارتی بنویسید تا میان نوشته‌ها، شماره‌ها و نویسندگان بگردیم.</p>
    <ol id="search-results" class="search-results"></ol>
    <noscript>
      <p>جست‌وجو به جاوااسکریپت نیاز دارد. می‌توانید از <a href="/articles/">فهرست نوشته‌ها</a>، <a href="/authors/">نویسندگان</a> یا <a href="/issues/">آرشیو شماره‌ها</a> استفاده کنید.</p>
    </noscript>
  </div>
  <script src="../scripts/search.ts"></script>
</Base>
