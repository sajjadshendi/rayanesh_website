---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import IssueCard from '../components/IssueCard.astro';
import AuthorCard from '../components/AuthorCard.astro';
import Arrow from '../components/Arrow.astro';
import { site, getCatalog, fa, issueLabel } from '../lib/catalog';
const { articleMap, issueMap, issues, authorMap, authors, articles } = await getCatalog();
const issue = issueMap.get(site.featuredIssue)!;
const selected = site.featuredArticles.map(id => articleMap.get(id)!);
const countFor = (id: string) => articles.filter(a => a.data.authors.includes(id)).length;
const writers = authors.filter(a => countFor(a.id) > 0).slice(0, 6);
---
<Base>
  <section class="opening shell" aria-labelledby="opening-title">
    <div class="opening-copy">
      <p class="pill pill-accent">پروندهٔ {issueLabel(issue)} · {issue.data.title}</p>
      <h1 id="opening-title">{site.heroTitle}</h1>
      <p class="lead">{site.heroDescription}</p>
      <div class="button-row">
        <a class="button" href={`/issues/${issue.id}/`}>ورق زدن این شماره <Arrow /></a>
        <a class="button button-secondary" href={issue.data.pdf}><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 19.5h14" /></svg>نسخهٔ PDF</a>
      </div>
      <div class="opening-index">
        <h2 id="opening-index-title">از این شماره بخوانید</h2>
        <ol class="index-cards" aria-labelledby="opening-index-title">{issue.data.toc.slice(0, 3).map((item, index) => <li><a class="index-card" href={item.article ? `/articles/${item.article}/` : `${issue.data.pdf}#page=${item.pdfPage}`}><span class="index-number" aria-hidden="true">{fa(index + 1)}</span><span class="index-text"><span class="index-title">{item.title}</span><small>{item.article ? 'خواندن در سایت' : <>نسخهٔ PDF، صفحهٔ {fa(item.pdfPage)} <span aria-hidden="true">↗</span></>}</small></span></a></li>)}</ol>
      </div>
    </div>
    <figure class="opening-cover">
      <a href={`/issues/${issue.id}/`} tabindex="-1" aria-hidden="true"><img src={issue.data.cover} alt="" width="750" height="1060" fetchpriority="high" decoding="async" /></a>
      <figcaption><span class="sr-only">{issue.data.coverAlt}. </span>جلد {issueLabel(issue)}{issue.data.dateLabel && `، ${issue.data.dateLabel}`}</figcaption>
    </figure>
  </section>

  <section class="home-section shell" aria-labelledby="selected-heading">
    <div class="section-heading"><h2 id="selected-heading">برای مکث و خواندن</h2><a class="text-link" href="/articles/">همهٔ نوشته‌ها <Arrow /></a></div>
    <div class="card-grid">{selected.map(article => <ArticleCard article={article} authorMap={authorMap} issueMap={issueMap} />)}</div>
  </section>

  <section class="home-section shell" aria-labelledby="archive-heading">
    <div class="section-heading"><h2 id="archive-heading">هر شماره، یک جهان</h2><a class="text-link" href="/issues/">آرشیو شماره‌ها <Arrow /></a></div>
    <div class="issue-grid issue-grid-scroll">{issues.filter(i => i.data.kind === 'regular').slice(0, 4).map(issue => <IssueCard issue={issue} level={3} />)}</div>
  </section>

  <section class="home-section shell" aria-labelledby="people-heading">
    <div class="section-heading"><h2 id="people-heading">آدم‌های پشت کلمه‌ها</h2><a class="text-link" href="/authors/">همهٔ نویسندگان <Arrow /></a></div>
    <div class="author-grid">{writers.map(a => <AuthorCard author={a} count={countFor(a.id)} />)}</div>
  </section>
</Base>
