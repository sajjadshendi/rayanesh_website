---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import IssueCard from '../components/IssueCard.astro';
import AuthorCard from '../components/AuthorCard.astro';
import Avatar from '../components/Avatar.astro';
import Arrow from '../components/Arrow.astro';
import { site, getCatalog, fa, issueLabel, readingTime } from '../lib/catalog';
const { articleMap, issueMap, issues, authorMap, authors, articles } = await getCatalog();
const issue = issueMap.get(site.featuredIssue)!;
const selected = site.featuredArticles.map(id => articleMap.get(id)!);
const countFor = (id: string) => articles.filter(a => a.data.authors.includes(id)).length;
const writers = authors.filter(a => countFor(a.id) > 0).slice(0, 6);
const preview = issue.data.toc.slice(0, 3).map((item, index) => {
  const article = item.article ? articleMap.get(item.article) : undefined;
  const fromIssue = article?.data.issue === issue.id ? article : undefined;
  const people = (fromIssue?.data.authors ?? []).map(id => authorMap.get(id)).filter(a => a != null);
  return {
    href: fromIssue ? `/articles/${fromIssue.id}/` : `/issues/${issue.id}/`,
    number: fa(index + 1),
    title: item.title,
    people,
    minutes: fromIssue ? readingTime(fromIssue.body) : undefined,
  };
});
---
<Base>
  <section class="opening shell" aria-labelledby="opening-title">
    <div class="opening-copy">
      <p class="pill pill-accent">جلد {issueLabel(issue)} · {issue.data.title}</p>
      <h1 id="opening-title">{site.heroTitle}</h1>
      <p class="lead">{site.heroDescription}</p>
      <div class="button-row">
        <a class="button" href={`/issues/${issue.id}/`}>ورق زدن این شماره <Arrow /></a>
        <a class="button button-ghost" href={issue.data.pdf}><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 19.5h14" /></svg>نسخهٔ PDF</a>
      </div>
    </div>
    <figure class="opening-cover">
      <a href={`/issues/${issue.id}/`} tabindex="-1" aria-hidden="true"><img src={issue.data.cover} alt="" width="750" height="1060" fetchpriority="high" decoding="async" /></a>
      <figcaption><span class="sr-only">{issue.data.coverAlt}. </span>جلد {issueLabel(issue)}{issue.data.dateLabel && `، ${issue.data.dateLabel}`}</figcaption>
    </figure>
  </section>

  <section class="home-section shell" aria-labelledby="opening-index-title">
    <div class="section-heading">
      <h2 id="opening-index-title">از این شماره بخوانید</h2>
      <a class="text-link" href={`/issues/${issue.id}/`}>همه <Arrow /></a>
    </div>
    <ol class="index-cards">{preview.map(item => (
      <li>
        <a class="index-card" href={item.href}>
          <span class="index-top">
            <span class="index-num" aria-hidden="true">{item.number}</span>
            {item.minutes && (
              <span class="index-time">
                <svg class="icon icon-clock" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7.5" /><path d="M12 8.5V12l2.4 1.6" /></svg>
                {item.minutes} دقیقه خواندن
              </span>
            )}
          </span>
          <span class="index-title">{item.title}</span>
          {item.people.length > 0 && (
            <span class="index-foot">
              <span class="index-author">
                <Avatar author={item.people[0]} />
                <span>{item.people.map(person => person.data.name).join('، ')}</span>
              </span>
            </span>
          )}
        </a>
      </li>
    ))}</ol>
  </section>

  <section class="home-section shell" aria-labelledby="selected-heading">
    <div class="section-heading"><h2 id="selected-heading">برای مکث و خواندن</h2><a class="text-link" href="/articles/">همهٔ نوشته‌ها <Arrow /></a></div>
    <div class="card-grid">{selected.map(article => <ArticleCard article={article} authorMap={authorMap} issueMap={issueMap} />)}</div>
  </section>

  <section class="home-section shell" aria-labelledby="archive-heading">
    <div class="section-heading"><h2 id="archive-heading">هر شماره، یک جهان</h2><a class="text-link" href="/issues/">آرشیو شماره‌ها <Arrow /></a></div>
    <div class="issue-grid issue-grid-scroll">{issues.filter(i => i.data.kind === 'regular').slice(0, 4).map(issue => <IssueCard issue={issue} level={3} />)}</div>
  </section>

  <section class="home-section shell" aria-labelledby="people-heading">
    <div class="section-heading"><h2 id="people-heading">نویسندگان</h2><a class="text-link" href="/authors/">همهٔ نویسندگان <Arrow /></a></div>
    <div class="author-grid">{writers.map(a => <AuthorCard author={a} count={countFor(a.id)} />)}</div>
  </section>
</Base>
