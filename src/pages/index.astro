---
import { withBase } from '../lib/paths';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import IssueCard from '../components/IssueCard.astro';
import Avatar from '../components/Avatar.astro';
import Arrow from '../components/Arrow.astro';
import { site, getCatalog, fa, issueByline } from '../lib/catalog';
const { articleMap, issueMap, issues, authorMap, authors, articles } = await getCatalog();
const issue = issueMap.get(site.featuredIssue)!;
/* The featured issue and the one published before it. Each issue can select up to three homepage articles. */
const recent = issues.slice(issues.indexOf(issue), issues.indexOf(issue) + 2).map(item => {
  const tocOrder = item.data.toc.map(entry => entry.article).filter(id => id != null);
  const rank = (id: string) => { const at = tocOrder.indexOf(id); return at === -1 ? tocOrder.length : at; };
  const own = articles.filter(a => a.data.issue === item.id).sort((a, b) => rank(a.id) - rank(b.id));
  const chosen = (item.data.homepageArticles ?? []).map(id => articleMap.get(id)!).filter(article => article?.data.issue === item.id);
  return { issue: item, selected: chosen.length ? chosen : own.slice(0, 3) };
});
const countFor = (id: string) => articles.filter(a => a.data.authors.includes(id)).length;
const writers = authors.filter(a => countFor(a.id) > 0).slice(0, 8);
---
<Base>
  <section class="opening shell" aria-labelledby="opening-title">
    <p class="opening-meta">{issueByline(issue)}</p>
    <h1 id="opening-title">{site.heroTitle}</h1>
    <p class="lead">{site.heroDescription}</p>
    <div class="button-row opening-actions">
      <a data-astro-prefetch class="button" href={withBase(`/issues/${issue.id}/`)}>ورق زدن این شماره <Arrow /></a>
      <a class="button button-ghost" href={withBase(issue.data.pdf)}><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 19.5h14" /></svg>دریافت PDF</a>
    </div>
    <div class="opening-cover">
      <a data-astro-prefetch class="book" href={withBase(`/issues/${issue.id}/`)} tabindex="-1" aria-hidden="true">
        <img src={withBase(issue.data.cover)} alt="" width="750" height="1060" fetchpriority="high" decoding="async" />
      </a>
    </div>
  </section>

  <section class="home-section shell" aria-labelledby="recent-heading">
    <div class="section-heading"><h2 id="recent-heading">مطالب اخیر</h2><a data-astro-prefetch class="text-link" href={withBase('/articles/')}>همه نوشته‌ها <Arrow /></a></div>
    <div class="recent">{recent.map(({ issue: item, selected }) => (
      <div class="recent-col">
        <a data-astro-prefetch class="recent-cover" href={withBase(`/issues/${item.id}/`)} tabindex="-1" aria-hidden="true">
          <img class="recent-cover-crop" src={withBase(item.data.cover)} alt="" width="750" height="1060" loading="lazy" decoding="async" />
          <img class="recent-cover-full" src={withBase(item.data.cover)} alt="" width="750" height="1060" loading="lazy" decoding="async" />
        </a>
        <h3 class="recent-issue"><a data-astro-prefetch href={withBase(`/issues/${item.id}/`)}>{item.data.title}</a></h3>
        <p class="recent-date">{issueByline(item)}</p>
        {selected.length ? (
          <div class="recent-list">
            {selected.map(article => <ArticleCard article={article} authorMap={authorMap} issueMap={issueMap} media={false} level={4} />)}
          </div>
        ) : (
          <div class="recent-empty">
            <p>نوشته‌های این شماره هنوز روی سایت نیامده‌اند. نسخه کامل را می‌توانید به‌صورت PDF بخوانید.</p>
            <a class="button button-ghost" href={withBase(item.data.pdf)}><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 19.5h14" /></svg>دریافت PDF</a>
          </div>
        )}
      </div>
    ))}</div>
  </section>

  <section class="home-section shell" aria-labelledby="archive-heading">
    <div class="section-heading"><h2 id="archive-heading">هر جلد، یک جهان</h2><a data-astro-prefetch class="text-link" href={withBase('/issues/')}>گنجه <Arrow /></a></div>
    <div class="issue-grid issue-grid-five">{issues.slice(0, 5).map(issue => <IssueCard issue={issue} level={3} />)}</div>
  </section>

  <section class="home-section shell" aria-labelledby="people-heading">
    <div class="section-heading"><h2 id="people-heading">نویسندگان</h2><a data-astro-prefetch class="text-link" href={withBase('/authors/')}>همه نویسندگان <Arrow /></a></div>
    <ul class="writer-row">{writers.map(author => (
      <li>
        <a data-astro-prefetch class="writer" href={withBase(`/authors/${author.id}/`)}>
          <Avatar author={author} size="lg" />
          <span class="writer-name">{author.data.name}</span>
          <span class="writer-count">{fa(countFor(author.id))} نوشته</span>
        </a>
      </li>
    ))}</ul>
  </section>
</Base>
