---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---
<Base title="درباره نشریه رایانش" description="با نشریه رایانش آشنا شوید؛ نشریه علمی و فرهنگی دانشکده مهندسی کامپیوتر دانشگاه صنعتی شریف و خانه‌ای سبز برای شعر، ادب و روایت.">
  <div class="shell page about-page">
    <Breadcrumb items={[{ label: 'درباره رایانش' }]} />
    <header class="page-heading">
      <h1>خانه‌ای سبز از جنس شعر و ادب</h1>
    </header>
    <div class="prose">
      <p>نشریه‌ای از جنس شعر و ادب هستیم با اتاقی سبز‌رنگ در همکف دانشکده مهندسی کامپیوتر دانشگاه صنعتی شریف</p>
    </div>
  </div>
</Base>
