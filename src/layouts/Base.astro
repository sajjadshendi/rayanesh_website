---
import '@fontsource-variable/vazirmatn';
import '@fontsource-variable/noto-naskh-arabic';
import '../styles/global.css';
import { site, getCatalog, issueLabel } from '../lib/catalog';
interface Props { title?: string; description?: string; image?: string; article?: boolean; noindex?: boolean }
const { title, description = site.description, image, article = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — نشریهٔ علمی و فرهنگی`;
const path = Astro.url.pathname;
const isPreview = import.meta.env.CF_PAGES === '1' && import.meta.env.CF_PAGES_BRANCH !== 'main';
const blocked = noindex || isPreview || !Astro.site;
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const { issueMap } = await getCatalog();
const currentIssue = issueMap.get(site.featuredIssue)!;
const socialImage = image || currentIssue.data.cover;
const nav = [{ href: '/articles/', label: 'نوشته‌ها', also: ['/topics/'] }, { href: '/issues/', label: 'شماره‌ها' }, { href: '/authors/', label: 'نویسندگان' }, { href: '/about/', label: 'دربارهٔ رایانش' }];
const isCurrent = (item: { href: string; also?: string[] }) => [item.href, ...(item.also ?? [])].some(prefix => path.startsWith(prefix));
const primaryNav = [{ href: '/', label: 'خانهٔ رایانش' }, ...nav];
const isPrimaryCurrent = (item: { href: string; also?: string[] }) => item.href === '/' ? path === '/' : isCurrent(item);
---
<!doctype html>
<html lang="fa" dir="rtl" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e7" />
    {blocked && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL(socialImage, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/images/rayanesh-logo.png" />
    {Astro.site && <link rel="alternate" type="application/rss+xml" title="تازه‌های رایانش" href="/rss.xml" />}
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">رفتن به محتوای صفحه</a>
    <header class="masthead" id="masthead">
      <div class="nav-row shell">
        <a class="brand" href="/" aria-label="رایانش، صفحهٔ نخست">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-line" aria-hidden="true">نشریهٔ علمی و فرهنگی دانشکدهٔ مهندسی کامپیوتر شریف</span>
        </a>
        <nav class="site-nav" id="site-nav" aria-label="منوی اصلی">
          {primaryNav.map(item => <a href={item.href} aria-current={isPrimaryCurrent(item) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="nav-tools">
          <a href="/search/" class="tool-button" aria-label="جست‌وجو در رایانش" aria-current={path.startsWith('/search/') ? 'page' : undefined}><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m20 20-4.8-4.8" /></svg></a>
          <button id="theme-toggle" type="button" class="tool-button" hidden aria-label="فعال کردن حالت تیره"><svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg><svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg></button>
          <a class="issue-badge" href={`/issues/${currentIssue.id}/`}>{issueLabel(currentIssue)}{currentIssue.data.dateLabel && ` · ${currentIssue.data.dateLabel}`}</a>
          <button id="menu-toggle" type="button" class="tool-button menu-toggle" hidden aria-expanded="false" aria-controls="site-nav" aria-label="باز کردن منو"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path class="menu-line-top" d="M4 7h16" /><path class="menu-line-mid" d="M4 12h16" /><path class="menu-line-bottom" d="M4 17h16" /></svg></button>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-grid shell">
        <div class="footer-about"><a class="footer-title" href="/">رایانش</a><p>{site.tagline}</p><p class="muted">نشریهٔ انجمن علمی دانشکدهٔ مهندسی کامپیوتر دانشگاه صنعتی شریف.</p></div>
        <nav class="footer-col" aria-labelledby="footer-quick"><h2 id="footer-quick">دسترسی سریع</h2><ul>{nav.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ul></nav>
        <nav class="footer-col" aria-labelledby="footer-follow"><h2 id="footer-follow">همراه رایانش</h2><ul>{site.contactEmail && <li><a href={`mailto:${site.contactEmail}`}>ارسال نوشته و تماس</a></li>}{Astro.site && <li><a href="/rss.xml">خوراک نوشته‌ها (RSS)</a></li>}<li><a href="/search/">جست‌وجو</a></li><li><a href="/privacy/">حریم خصوصی</a></li></ul></nav>
      </div>
      <div class="sub-footer shell"><p>حقوق نوشته‌ها و تصاویر برای پدیدآورندگان و رایانش محفوظ است.</p></div>
    </footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
