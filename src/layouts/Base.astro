---
import { withBase, withoutBase } from '../lib/paths';
import '@fontsource-variable/vazirmatn';
import '@fontsource-variable/noto-naskh-arabic';
import '../styles/global.css';
import { site, getCatalog } from '../lib/catalog';
interface Props { title?: string; description?: string; image?: string; article?: boolean; noindex?: boolean }
const { title, description = site.description, image, article = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — نشریه علمی و فرهنگی`;
const path = withoutBase(Astro.url.pathname);
const blocked = noindex || !Astro.site;
const canonical = Astro.site ? new URL(withBase(path), Astro.site).href : undefined;
const { issueMap } = await getCatalog();
const currentIssue = issueMap.get(site.featuredIssue)!;
const socialImage = image || currentIssue.data.cover;
const nav = [{ href: '/articles/', label: 'نوشته‌ها' }, { href: '/issues/', label: 'گنجه' }, { href: '/authors/', label: 'نویسندگان' }, { href: '/about/', label: 'درباره رایانش' }];
const isCurrent = (item: { href: string; also?: string[] }) => [item.href, ...(item.also ?? [])].some(prefix => path.startsWith(prefix));
const primaryNav = [{ href: '/', label: 'خانه رایانش' }, ...nav];
const isPrimaryCurrent = (item: { href: string; also?: string[] }) => item.href === '/' ? path === '/' : isCurrent(item);
---
<!doctype html>
<html lang="fa" dir="rtl" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; script-src-attr 'none'; worker-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e7" />
    {blocked && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={withBase(canonical)} />}
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL(withBase(socialImage), Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={withBase('/images/rayanesh-logo.png')} />
    {Astro.site && <link rel="alternate" type="application/rss+xml" title="تازه‌های رایانش" href={withBase('/rss.xml')} />}
    <script is:inline src={withBase('/theme-init.js')}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">رفتن به محتوای صفحه</a>
    <header class="masthead" id="masthead">
      <div class="nav-row shell">
        <a class="brand" href={withBase('/')} aria-label="رایانش، صفحه نخست">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-line" aria-hidden="true">نشریه علمی و فرهنگی دانشکده مهندسی کامپیوتر شریف</span>
        </a>
        <nav class="site-nav" id="site-nav" aria-label="منوی اصلی">
          {primaryNav.map(item => <a href={withBase(item.href)} aria-current={isPrimaryCurrent(item) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="nav-tools">
          <a href={withBase('/articles/#find')} class="tool-button" aria-label="جست‌وجو در نوشته‌ها"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m20 20-4.8-4.8" /></svg></a>
          <button id="theme-toggle" type="button" class="tool-button" hidden aria-pressed="false" aria-label="فعال کردن حالت تیره"><svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg><svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg></button>
          <button id="menu-toggle" type="button" class="tool-button menu-toggle" hidden aria-expanded="false" aria-controls="site-nav" aria-label="باز کردن منو"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path class="menu-line-top" d="M4 7h16" /><path class="menu-line-mid" d="M4 12h16" /><path class="menu-line-bottom" d="M4 17h16" /></svg></button>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-grid shell">
        <div class="footer-about">
          <a class="footer-title" href={withBase('/')}>رایانش</a>
          <p class="muted">نشریه انجمن علمی دانشکده مهندسی کامپیوتر دانشگاه صنعتی شریف.</p>
        </div>
        <nav class="footer-col" aria-labelledby="footer-quick">
          <h2 class="footer-heading" id="footer-quick">دسترسی سریع</h2>
          <ul>{nav.map(item => <li><a href={withBase(item.href)}>{item.label}</a></li>)}</ul>
        </nav>
        <div class="footer-col">
          <h2 class="footer-heading" id="footer-follow">ارتباط با رایانش</h2>
          <ul>
            <li><a href="mailto:nashrie.ce.sharif@gmail.com"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg><span class="footer-email">nashrie.ce.sharif@gmail.com</span></a></li>
          </ul>
        </div>
        <div class="footer-social">
          <h2 class="footer-heading" id="footer-social">رایانش در شبکه‌های اجتماعی</h2>
          <ul class="social-list" aria-labelledby="footer-social">
            <li><a href="https://t.me/+zAuAbR9NW4U3MWM0" rel="noopener noreferrer" aria-label="تلگرام" title="تلگرام"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 4.3 3.4 11c-.9.4-.9 1.6.1 1.9l4.2 1.4 1.6 5c.3.8 1.3 1 1.8.4l2.4-2.4 4.3 3.2c.7.5 1.6.1 1.8-.7l2.8-13.5c.2-.9-.7-1.6-1.6-1.3Z" /><path d="m7.7 14.3 9.6-6.4-6.6 7.4" /></svg></a></li>
          </ul>
        </div>
      </div>
      <div class="sub-footer shell"><p>حقوق نوشته‌ها و تصاویر برای پدیدآورندگان و رایانش محفوظ است.</p></div>
    </footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
