---
import '@fontsource-variable/vazirmatn';
import '@fontsource-variable/noto-naskh-arabic';
import '../styles/global.css';
import { site, getCatalog, issueLabel } from '../lib/catalog';
interface Props { title?: string; description?: string; image?: string; article?: boolean; noindex?: boolean }
const { title, description = site.description, image, article = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — نشریهٔ علمی و فرهنگی`;
const path = Astro.url.pathname;
const isPreview = import.meta.env.CF_PAGES === '1' && import.meta.env.CF_PAGES_BRANCH !== 'main';
const blocked = noindex || isPreview || !Astro.site;
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const { issueMap } = await getCatalog();
const currentIssue = issueMap.get(site.featuredIssue)!;
const socialImage = image || currentIssue.data.cover;
const nav = [{ href: '/articles/', label: 'نوشته‌ها' }, { href: '/issues/', label: 'شماره‌ها' }, { href: '/authors/', label: 'نویسندگان' }, { href: '/about/', label: 'دربارهٔ رایانش' }];
---
<!doctype html>
<html lang="fa" dir="rtl" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e7" />
    {blocked && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL(socialImage, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/images/rayanesh-logo.png" />
    {Astro.site && <link rel="alternate" type="application/rss+xml" title="تازه‌های رایانش" href="/rss.xml" />}
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">رفتن به محتوای صفحه</a>
    <header class="masthead shell">
      <div class="masthead-top">
        <div class="masthead-note"><span>نشریهٔ علمی و فرهنگی</span><span>دانشکدهٔ مهندسی کامپیوتر شریف</span></div>
        <a class="brand" href="/" aria-label="رایانش، صفحهٔ نخست">
          <img src="/images/rayanesh-logo.png" alt="رایانش" width="456" height="231" fetchpriority="high" />
        </a>
        <div class="masthead-issue"><a href={`/issues/${currentIssue.id}/`}>{issueLabel(currentIssue)} · {currentIssue.data.title}</a>{currentIssue.data.dateLabel && <span>{currentIssue.data.dateLabel}</span>}</div>
      </div>
      <div class="nav-row">
        <nav aria-label="منوی اصلی">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>خانهٔ رایانش</a>
          {nav.map(item => <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="nav-tools">
          <a href="/search/" class="search-link" aria-label="جست‌وجو در رایانش"><span class="search-icon" aria-hidden="true"></span><span>جست‌وجو</span></a>
          <button id="theme-toggle" type="button" class="quiet-button" hidden aria-label="فعال کردن حالت تیره">حالت تیره</button>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <div><a class="footer-title" href="/">رایانش</a><p>{site.tagline}</p><p class="muted small">نشریهٔ انجمن علمی دانشکدهٔ مهندسی کامپیوتر دانشگاه صنعتی شریف</p></div>
      <nav aria-label="پیوندهای پایین صفحه"><a href="/issues/">آرشیو شماره‌ها</a><a href="/about/">دربارهٔ ما</a><a href="/privacy/">حریم خصوصی</a>{Astro.site && <a href="/rss.xml">خوراک نوشته‌ها (RSS)</a>}</nav>
      <p class="copyright small">حقوق نوشته‌ها و تصاویر برای پدیدآورندگان و رایانش محفوظ است.</p>
    </footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
